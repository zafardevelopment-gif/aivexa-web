# Supabase project (Project Settings > API) — copy to .env.local and fill in.
# This file is a TEMPLATE — never put real keys here, it is not gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — required for the /admin panel (server-side only,
# never exposed to the browser). Project Settings > API > service_role.
# NEVER commit this or use it client-side.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Razorpay — Digital Store payments (razorpay.com > Settings > API Keys)
# Key ID is public (used in browser checkout), Secret is server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# Google AdSense — fill in AFTER you get approved (Account > Account information
# on adsense.google.com). Format: ca-pub-XXXXXXXXXXXXXXXX
# Leave empty until then — the ad script only loads when this is set.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_GA_ID=

# --- Unscroll family backend (/api/unscroll) ---
# PostgreSQL on the VPS. Run db/unscroll/001_unscroll.sql once against this database.
UNSCROLL_DATABASE_URL=postgres://unscroll:CHANGE_ME@127.0.0.1:5432/aivexa
# Firebase service-account JSON (Firebase console → Project settings → Service accounts → Generate key)
UNSCROLL_FCM_SERVICE_ACCOUNT_FILE=/var/www/aivexa-web/secrets/unscroll-firebase.json
# Random string; the daily cron must send it as "Authorization: Bearer <secret>"
UNSCROLL_CRON_SECRET=CHANGE_ME_LONG_RANDOM
# Optional sender for sign-in codes (domain must be verified in Resend)
UNSCROLL_EMAIL_FROM=Unscroll <no-reply@aivexallp.com>
# Keep "true" until Google Play billing is live
UNSCROLL_UNLOCK_ALL=true
